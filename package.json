{
  "name": "streaming-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "refresh:listings": "ts-node scripts/fetchAndSaveContent.ts",
    "refresh:listings:mjs": "node scripts/fetchAndSaveContent.mjs",
    "localize:images": "node scripts/downloadMovieImagesAndUpdateJson.mjs && node scripts/downloadSeriesImagesAndUpdateJson.mjs && node scripts/downloadShowsImagesAndUpdateJson.mjs && node scripts/downloadMixImagesAndUpdateJson.mjs",
    "prepare:static-data": "npm run refresh:listings && npm run localize:images"
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "next": "16.2.1",
    "node-fetch": "^3.3.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
